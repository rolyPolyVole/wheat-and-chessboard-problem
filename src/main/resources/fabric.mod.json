    "authors": ["rolyPolyVole"],
    "contact": {},
    "license": "GPL-3.0",
    "icon": "icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "dev.rolypolyvole.wheatandchessboard.WheatAndChessboardMod"
        ]
